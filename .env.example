# ============================================================
# myDashboardV2 环境变量配置模板
# 复制此文件为 .env 后按需修改：cp .env.example .env
# ============================================================

# ---- AI 模型 ----
# Qoder 平台模型 key，无需 API Key，走订阅额度。括号内为积分倍率。
#   kmodel_latest = Kimi-K3 (0.8x)        dmodel   = DeepSeek-V4-Pro (0.5x)
#   kmodel        = Kimi-K2.7-Code (0.3x) mmodel   = MiniMax-M3 (0.2x)
#   qmodel_38max  = Qwen3.8-Max (0.5x)    gm51model = GLM-5.2 (0.6x)
#   auto          = 平台自动选择 (1x)
# 完整实时列表：node scripts/list-models.mjs
AI_MODEL=kmodel_latest

# ---- 服务端口 ----
# PORT=3015
# HOST=127.0.0.1
